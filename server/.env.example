CORS_ORIGIN="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_gmail_app_password"
