PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://username:password@localhost:5432/agnicrm?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/agnicrm?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
